  "authors": [
    {
      "name": "AARUTO",
      "email": "aaruto@example.com",
      "url": "https://github.com/AARUTO347",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AARUTO347/AARUESP.git"
  },
  "homepage": "https://github.com/AARUTO347/AARUESP",
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32", "espressif8266"],
